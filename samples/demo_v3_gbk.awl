SUBROUTINE_BLOCK 指令大全示例:SBR20
TITLE=S7-200 SMART 常用指令学习示例（一网络一逻辑行）
BEGIN
Network 1
//位逻辑：LD装载 A与 AN与非 O或 ON或非 =输出
	LD     I0.0
	A      I0.1
	AN     I0.2
	O      I0.3
	ON     I0.4
	=      Q0.0
Network 2
//置位 S：把 Q0.1 起连续 3 个位置1
	LD     I0.5
	S      Q0.1, 3
Network 3
//复位 R：把 Q0.1 起连续 3 个位清0
	LD     I0.6
	R      Q0.1, 3
Network 4
//立即置位 SI：不等扫描周期立刻作用
	LD     I0.7
	SI     Q0.2, 1
Network 5
//立即复位 RI
	LD     I1.0
	RI     Q0.2, 1
Network 6
//上升沿 EU：信号 0→1 时导通一个周期
	LD     I1.1
	EU
	=      M0.0
Network 7
//下降沿 ED：信号 1→0 时导通一个周期
	LD     I1.2
	ED
	=      M0.1
Network 8
//取反 NOT
	LD     I1.3
	NOT
	=      M0.2
Network 9
//逻辑堆栈 LPS压栈/LRD读栈/LPP出栈：一个条件下挂多个输出
	LD     I2.0
	LPS
	A      I2.1
	=      Q1.0
	LRD
	A      I2.2
	=      Q1.1
	LPP
	A      I2.3
	=      Q1.2
Network 10
//块或 OLD：两个逻辑块并联（块1 OR 块2）
	LD     I2.4
	A      I2.5
	LD     I2.6
	A      I2.7
	OLD
	=      Q1.3
Network 11
//块与 ALD：两个逻辑块串联（块1 AND 块2）
	LD     I3.0
	O      I3.1
	LD     I3.2
	O      I3.3
	ALD
	=      Q1.4
Network 12
//传送 MOVB字节/MOVW字/MOVD双字/MOVR实数（16#十六进制常量）
	LD     SM0.0
	MOVB   16#FF, VB100
	MOVW   +1000, VW102
	MOVD   +100000, VD104
	MOVR   3.14, VD108
Network 13
//整数运算 +I -I *I /I（OUT = IN1 运算 OUT）
	LD     SM0.0
	MOVW   +100, VW200
	+I     +50, VW200
	-I     +20, VW200
	*I     +3, VW200
	/I     +2, VW200
Network 14
//双整数运算 +D -D *D /D
	LD     SM0.0
	MOVD   +100000, VD210
	+D     +50000, VD210
	-D     +10000, VD210
	*D     +2, VD210
	/D     +4, VD210
Network 15
//实数运算 +R *R 与开方 SQRT
	LD     SM0.0
	MOVR   100.0, VD220
	+R     50.0, VD220
	*R     2.0, VD220
	SQRT   VD220, VD224
Network 16
//加一 INCB/INCW/INCD 减一 DECB/DECW/DECD
	LD     SM0.0
	INCB   VB230
	INCW   VW232
	INCD   VD234
	DECB   VB230
	DECW   VW232
	DECD   VD234
Network 17
//字节逻辑 ANDB与 ORB或 XORB异或 INVB取反
	LD     SM0.0
	ANDB   16#0F, VB240
	ORB    16#F0, VB240
	XORB   16#FF, VB240
	INVB   VB240
Network 18
//字逻辑 ANDW ORW XORW INVW
	LD     SM0.0
	ANDW   16#0F0F, VW242
	ORW    16#F000, VW242
	XORW   16#FFFF, VW242
	INVW   VW242
Network 19
//移位 SLW左移/SRW右移；循环 RLW左循环/RRW右循环
	LD     SM0.0
	SLW    VW250, 4
	SRW    VW250, 2
	RLW    VW252, 1
	RRW    VW252, 1
Network 20
//字节移位/循环 SLB/SRB/RLB/RRB
	LD     SM0.0
	SLB    VB254, 2
	SRB    VB254, 1
	RLB    VB255, 3
	RRB    VB255, 1
Network 21
//比较：字等于 LDW=
	LDW=   VW260, +100
	=      Q2.0
Network 22
//比较：字大于 LDW>
	LDW>   VW260, +50
	=      Q2.1
Network 23
//比较：双字小于 LDD<
	LDD<   VD262, +1000
	=      Q2.2
Network 24
//比较：字节大于等于 LDB>=
	LDB>=  VB266, 10
	=      Q2.3
Network 25
//比较串联 AW<：与前面触点串联比较
	LD     M1.0
	AW<    VW260, +200
	=      Q2.4
Network 26
//比较并联 OW>：与前面触点并联比较
	LD     M1.1
	OW>    VW260, +300
	=      Q2.5
Network 27
//转换 ITD整数→双整数 DTR双整数→实数
	LD     SM0.0
	ITD    VW270, VD272
	DTR    VD272, VD276
Network 28
//取整 ROUND四舍五入 TRUNC去小数
	LD     SM0.0
	ROUND  VD276, VD280
	TRUNC  VD276, VD284
Network 29
//BCD互转 BCDI（BCD→整数）IBCD（整数→BCD）
	LD     SM0.0
	MOVW   16#1234, VW288
	BCDI   VW288
	IBCD   VW288
Network 30
//接通延时 TON：I3.4 接通 100×10ms=1s 后 T37 置位
	LD     I3.4
	TON    T37, +100
Network 31
//用定时器触点驱动输出
	LD     T37
	=      Q3.0
Network 32
//断开延时 TOF：断开后延时才复位
	LD     I3.5
	TOF    T38, +50
Network 33
//保持型延时 TONR：断电保持累计值
	LD     I3.6
	TONR   T0, +200
Network 34
//加计数 CTU：CU上升沿+1（第1个LD），R复位（第2个LD），到PV=10置位
	LD     I4.0
	LD     I4.1
	CTU    C0, +10
Network 35
//用计数器触点驱动输出
	LD     C0
	=      Q4.0
Network 36
//减计数 CTD：CD减1（第1个LD），LD装入PV（第2个LD），到0置位
	LD     I4.2
	LD     I4.3
	CTD    C1, +5
Network 37
//加减计数 CTUD：CU加/CD减/R复位（三个LD依次）
	LD     I5.0
	LD     I5.1
	LD     I5.2
	CTUD   C2, +100
Network 38
//跳转 JMP：条件成立跳到标号1
	LD     I6.0
	JMP    1
Network 39
//被跳过的程序段（条件成立时不执行）
	LD     SM0.0
	MOVB   1, VB290
Network 40
//标号 LBL：跳转目标
	LBL    1
Network 41
//循环 FOR：VW292 从 1 到 10；循环体在本网络内
	LD     SM0.0
	FOR    VW292, +1, +10
	INCB   VB294
Network 42
//循环结束 NEXT（单独占一个网络）
	NEXT
Network 43
//子程序条件返回 CRET
	LD     I7.0
	CRET
END_SUBROUTINE_BLOCK
