SUBROUTINE_BLOCK 字符串处理:SBR12
TITLE=字符串指令 —— 报文与提示文本拼装
BEGIN
Network 1
//求字符串长度 SLEN
	LD     SM0.0
	SLEN   VB1100, VB1150
Network 2
//复制字符串 SCPY：设备名 → 输出缓冲
	LD     SM0.0
	SCPY   VB1100, VB1160
Network 3
//连接字符串 SCAT：把报警文本接到设备名后面
	LD     SM0.0
	SCAT   VB1120, VB1160
Network 4
//复制子串 SSCPY：从第 1 个字符起取 4 个（取设备编号）
	LD     SM0.0
	SSCPY  VB1100, 1, 4, VB1180
Network 5
//在字符串中查找子串 SFND：返回起始位置，0 表示没找到
	LD     SM0.0
	SFND   VB1100, VB1120, VB1190
Network 6
//在字符串中查找单个字符 CFND
	LD     SM0.0
	CFND   VB1100, VB1121, VB1191
Network 7
//没找到关键字时置提示位
	LDB=   VB1190, 16#00
	S      V602.1, 1
END_SUBROUTINE_BLOCK
