SUBROUTINE_BLOCK 顺控主流程:SBR3
TITLE=SCR 顺序控制 —— 7 步：初始/上料/夹紧/加工/松开/出料/完成
BEGIN
Network 1
//===== 步 S0.0 初始步：等待启动与来料 =====
	LSCR   S0.0
Network 2
//本步动作：复位全部执行机构输出
	LD     SM0.0
	R      Q0.2, 4
Network 3
//就绪指示
	LD     SM0.0
	=      Q1.2
Network 4
//转移条件：已启动 且 检测到工件 → 上料步
	LD     M0.1
	A      I1.2
	SCRT   S0.1
Network 5
	SCRE
Network 6
//===== 步 S0.1 上料步 =====
	LSCR   S0.1
Network 7
//上料电机运行
	LD     SM0.0
	=      Q0.2
Network 8
//上料超时监视（参数 VW100）
	LD     SM0.0
	TON    T40, +100
Network 9
//转移条件：上料到位 → 夹紧步
	LD     I0.5
	SCRT   S0.2
Network 10
//超时未到位 → 置上料故障
	LD     T40
	AN     I0.5
	S      V600.2, 1
Network 11
	SCRE
Network 12
//===== 步 S0.2 夹紧步 =====
	LSCR   S0.2
Network 13
//夹紧气缸伸出（置位保持）
	LD     SM0.0
	S      Q0.5, 1
Network 14
//夹紧确认延时
	LD     SM0.0
	TON    T41, +30
Network 15
//转移条件：延时到 且 伸出到位 → 加工步
	LD     T41
	A      I1.0
	SCRT   S0.3
Network 16
	SCRE
Network 17
//===== 步 S0.3 加工步 =====
	LSCR   S0.3
Network 18
//主轴启动
	LD     SM0.0
	=      Q0.3
Network 19
//加工计时
	LD     SM0.0
	TON    T42, +200
Network 20
//加工件数累加（上升沿只加一次）
	LD     T42
	EU
	INCW   VW130
Network 21
//转移条件：加工时间到 且 加工到位 → 松开步
	LD     T42
	A      I0.6
	SCRT   S0.4
Network 22
	SCRE
Network 23
//===== 步 S0.4 松开步 =====
	LSCR   S0.4
Network 24
//气缸缩回
	LD     SM0.0
	R      Q0.5, 1
Network 25
//缩回确认延时
	LD     SM0.0
	TON    T43, +30
Network 26
//转移条件：缩回到位 → 出料步
	LD     T43
	A      I1.1
	SCRT   S0.5
Network 27
	SCRE
Network 28
//===== 步 S0.5 出料步 =====
	LSCR   S0.5
Network 29
//出料电机运行
	LD     SM0.0
	=      Q0.4
Network 30
//出料超时监视
	LD     SM0.0
	TON    T44, +150
Network 31
//转移条件：出料到位 → 完成步
	LD     I0.7
	SCRT   S0.6
Network 32
//超时未到位 → 置出料故障
	LD     T44
	AN     I0.7
	S      V600.3, 1
Network 33
	SCRE
Network 34
//===== 步 S0.6 完成步：产量累加后回初始步 =====
	LSCR   S0.6
Network 35
//总产量累加
	LD     SM0.0
	INCD   VD140
Network 36
//完成指示
	LD     SM0.0
	=      Q1.4
Network 37
//节拍间隔
	LD     SM0.0
	TON    T45, +20
Network 38
//转移条件：间隔到 → 回初始步，形成循环
	LD     T45
	SCRT   S0.0
Network 39
	SCRE
Network 40
//===== 顺控段之外：停止或急停时强制回初始步 =====
	LD     I0.2
	O      M3.0
	R      S0.0, 8
Network 41
//强制置初始步
	LD     I0.2
	O      M3.0
	S      S0.0, 1
END_SUBROUTINE_BLOCK
