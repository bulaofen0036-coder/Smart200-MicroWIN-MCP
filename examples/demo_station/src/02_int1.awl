INTERRUPT_BLOCK INT_1:INT1
TITLE=定时中断0 —— 100ms 周期采样与计时
BEGIN
Network 1
//急停时直接返回，不做采样（条件返回 CRETI）
	LD     M3.0
	CRETI
Network 2
//采样累加，为滑动平均做准备
	LD     SM0.0
	MOVW   AIW16, VW910
	ITD    VW910, VD912
	+D     VD912, VD916
	INCW   VW920
Network 3
//满 10 次求平均并清累加器
	LDW>=  VW920, +10
	MOVD   VD916, VD924
	/D     +10, VD924
	MOVD   +0, VD916
	MOVW   +0, VW920
Network 4
//中断内 100ms 节拍累计
	LD     SM0.0
	INCD   VD928
Network 5
//过程变量归一化到 0.0~1.0 送 PID 回路表 PV 位（VD1000）
	LD     SM0.0
	ITD    VW200, VD1044
	DTR    VD1044, VD1000
	/R     32000.0, VD1000
Network 6
//PID 回路运算 —— 回路表 VB1000，回路号 0
	LD     SM0.0
	PID    VB1000, 0
Network 7
//输出反归一化：0.0~1.0 → 0~32000，接调节阀时把 VW1040 送 AQW16
	LD     SM0.0
	MOVR   VD1008, VD1036
	*R     32000.0, VD1036
	ROUND  VD1036, VD1040
	DTI    VD1040, VW1044
END_INTERRUPT_BLOCK
