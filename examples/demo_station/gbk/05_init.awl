SUBROUTINE_BLOCK 系统初始化:SBR0
TITLE=上电初始化 —— 工艺参数、顺控步、中断连接
BEGIN
Network 1
//工艺定时参数（单位 100ms）
	LD     SM0.0
	MOVW   +100, VW100
	MOVW   +30, VW102
	MOVW   +200, VW104
	MOVW   +150, VW106
	MOVW   +20, VW108
Network 2
//模拟量量程：AI 原始值下限/上限，工程量下限/上限
	LD     SM0.0
	MOVW   +6400, VW110
	MOVW   +32000, VW112
	MOVR   0.0, VD114
	MOVR   100.0, VD118
Network 3
//设定值与允许偏差
	LD     SM0.0
	MOVR   75.0, VD256
	MOVR   5.0, VD264
Network 4
//产量与统计清零
	LD     SM0.0
	MOVW   +0, VW130
	MOVD   +0, VD140
	MOVD   +0, VD880
	MOVD   +0, VD884
Network 5
//报警字与状态位清零
	LD     SM0.0
	FILL   +0, VW600, 8
	MOVB   0, MB0
	MOVB   0, MB1
	MOVB   0, MB2
	MOVB   0, MB3
Network 6
//顺控：复位全部步，只置初始步 S0.0
	LD     SM0.0
	R      S0.0, 8
Network 7
//置初始步
	LD     SM0.0
	S      S0.0, 1
Network 8
//使能诊断子程序（供 CRET 条件返回用）
	LD     SM0.0
	S      V0.0, 1
Network 9
//定时中断0 周期 = 100ms
	LD     SM0.0
	MOVB   100, SMB34
Network 10
//关联中断：事件0=I0.0上升沿，事件10=定时中断0，事件12=HSC0 CV=PV
	LD     SM0.0
	ATCH   INT_0, 0
	ATCH   INT_1, 10
	ATCH   INT_2, 12
Network 11
//PID0 回路表（VB1000 起 36 字节）：设定值与整定参数，归一化 0.0~1.0
	LD     SM0.0
	MOVR   0.75, VD1004
	MOVR   0.6, VD1012
	MOVR   0.1, VD1016
	MOVR   30.0, VD1020
	MOVR   0.0, VD1024
Network 12
//全局开中断
	LD     SM0.0
	ENI
END_SUBROUTINE_BLOCK
